# 复制为 .env 后按本机环境填写，.env 不会提交到仓库。
JAVA_INTERVIEW_RAG_MYSQL_ROOT_PASSWORD=replace-me-root
JAVA_INTERVIEW_RAG_DB_URL=jdbc:mysql://127.0.0.1:3306/java_interview_rag?serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8&connectTimeout=5000&socketTimeout=15000&tcpKeepAlive=true
JAVA_INTERVIEW_RAG_DB_USERNAME=java_interview_rag
JAVA_INTERVIEW_RAG_DB_PASSWORD=replace-me

JAVA_INTERVIEW_RAG_DASHSCOPE_API_KEY=replace-me
JAVA_INTERVIEW_RAG_DASHSCOPE_EMBED_MODEL=text-embedding-v3
JAVA_INTERVIEW_RAG_QDRANT_HOST=127.0.0.1
JAVA_INTERVIEW_RAG_QDRANT_PORT=6334
JAVA_INTERVIEW_RAG_QDRANT_COLLECTION=java-interview-rag-chunks
